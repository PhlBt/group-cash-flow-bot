# Telegram Bot Token
# Получите токен от @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# MongoDB Connection String
# Для MongoDB Atlas (облако)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/cashflow

# Для локальной установки MongoDB (если нужна)
# MONGODB_URL=mongodb://localhost:27017/cashflow

# Node Environment
NODE_ENV=development
